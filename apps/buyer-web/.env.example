# Chinooz — Environment Variables
# Copy this file to .env.local and fill in values

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Chinooz
NEXT_PUBLIC_SITE_URL=https://chinooz.com

# SEO & Verification
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-code-here

# API (future)
# NEXT_PUBLIC_API_URL=https://api.chinooz.com

# Waitlist Backend (when ready to connect real backend)
# NEXT_PUBLIC_WAITLIST_API_URL=https://api.chinooz.com/waitlist
# WAITLIST_API_KEY=your-secret-api-key-here

# Analytics (future)
# NEXT_PUBLIC_GA_ID=

# Payments (future — server-side only, never expose secrets)
# ESEWA_MERCHANT_ID=
# KHALTI_SECRET_KEY=

# Feature Flags
NEXT_PUBLIC_ENABLE_SMOOTH_SCROLL=true
NEXT_PUBLIC_ENABLE_MOTION=true
