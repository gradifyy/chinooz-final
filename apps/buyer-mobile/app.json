      "bundleIdentifier": "com.chinooz.buyer"
    },
    "android": {
      "package": "com.chinooz.buyer",
      "adaptiveIcon": {
        "backgroundColor": "#8A1B57"
      }
    },
    "plugins": ["expo-router", "expo-font"]
  }
}
